    "@fullcalendar/timegrid": "^6.1.15",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.20.0",
    "@tanstack/react-query": "^5.59.0",
    "dotenv": "^17.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^3.2.10",
    "@vitejs/plugin-react": "^4.3.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.20.0",
